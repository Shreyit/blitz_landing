# Local Edge Function secrets. Never commit a filled-in .env file.
BLITZ_SUPABASE_SECRET_KEY=replace-with-server-secret-key
MAIL_WORKER_SECRET=replace-with-a-random-secret-at-least-32-characters
# Gmail / Google Workspace SMTP: use the sender account's new app password.
MAIL_PROVIDER=smtp
MAIL_FROM="Bachelor's BLITZ <bachelorsblitz@tiss.ac.in>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=bachelorsblitz@tiss.ac.in
SMTP_PASSWORD=replace-locally-with-new-app-password
# Alternatively choose MAIL_PROVIDER=resend and configure these:
# RESEND_API_KEY=replace-with-resend-api-key
# MAIL_FROM=BLITZ <events@your-verified-domain.example>
