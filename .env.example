# Choose fastapi for the existing local API, or supabase for the new backend.
NEXT_PUBLIC_BACKEND_PROVIDER=fastapi
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/auction/live

# Supabase mode: publishable values are safe in the browser; the secret is not.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy-from-supabase-status
# SUPABASE_SECRET_KEY=copy-the-server-secret-from-supabase-status
# PUBLIC_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Supply an owned/licensed .riv export to activate Rive:
# NEXT_PUBLIC_RIVE_SRC=/animations/blitz.riv
# NEXT_PUBLIC_RIVE_STATE_MACHINE=Guide
